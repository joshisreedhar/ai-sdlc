# Phase 1 configuration surface.
# Every variable maps 1:1 to a field on urlshortener.shared_kernel.config.settings.Settings.
# Copy to .env for local development:  cp .env.example .env

# --- General -------------------------------------------------------------
URLSHORTENER_APP_ENV=local
URLSHORTENER_LOG_LEVEL=INFO

# --- Datastores ----------------------------------------------------------
# Async SQLAlchemy DSN (asyncpg driver).
URLSHORTENER_DATABASE_URL=postgresql+asyncpg://urlshortener:urlshortener@localhost:5432/urlshortener
URLSHORTENER_REDIS_URL=redis://localhost:6379/0

# --- Link creation (Management API) --------------------------------------
URLSHORTENER_SHORT_URL_BASE=http://localhost:8001
URLSHORTENER_SHORT_CODE_LENGTH=7
URLSHORTENER_SHORT_CODE_MAX_ATTEMPTS=5

# --- Redirection Engine --------------------------------------------------
URLSHORTENER_LINK_CACHE_TTL_SECONDS=3600

# --- Click event stream (producer + stub consumer) -----------------------
URLSHORTENER_CLICK_EVENT_STREAM=clicks.v1
URLSHORTENER_CLICK_EVENT_CONSUMER_GROUP=analytics
URLSHORTENER_CLICK_STREAM_MAX_LEN=100000
